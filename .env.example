# Copy to `.env` and adjust. Every value is optional; defaults live in app/config.py

# Server
HOST=127.0.0.1
PORT=8000
# LOG_BUFFER_SIZE=2000   # log lines kept for the panel's Live logs

# Scraping
HEADLESS=true
# REGION_CODE=us   # bias results to a country (Google 'gl' parameter)
DETAIL_CONCURRENCY=3
MAX_RESULTS=500
# MAX_SCANNED=5000   # distinct listings read per job while looking for matches
# MAX_SECTIONS=200   # map sections searched per job ("whole area" search); each one is a Google search
# PROXY_SERVER=http://user:pass@proxy-host:3128

# Enrichment
ENRICH_MAX_PAGES=6
ENRICH_CONCURRENCY=4
ENRICH_BROWSER_FALLBACK=true
DEFAULT_REGION=US

# Web search for websites a business doesn't list on Google Maps (optional per search)
# WEB_SEARCH_ENGINE=duckduckgo   # or bing; the other one is used when the first refuses
# WEB_SEARCH_DELAY_S=3

# Email outreach - your mailbox (docs/PLAYBOOK.md step 1). Gmail / Google Workspace: an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_FOLDER=INBOX
# MAIL_USERNAME=you@yourdomain.com
# MAIL_PASSWORD=abcd efgh ijkl mnop
# SENDER_EMAIL=                    # From address; empty = MAIL_USERNAME
# SENDER_NAME=Your Name
# SENDER_COMPANY=Your Company
# SENDER_ADDRESS=Street, City, State ZIP   # required: it goes in the footer of every email
# When emails go out: Mon-Fri 08:00-12:00 in the leads' time zone, 30 a day, 90-240 s apart
# OUTREACH_TIMEZONE=America/Chicago
# OUTREACH_DAYS=mon-fri
# OUTREACH_HOURS=8-12
# OUTREACH_DAILY_LIMIT=30
# OUTREACH_MIN_GAP_S=90
# OUTREACH_MAX_GAP_S=240
# OUTREACH_CHECK_MINUTES=10        # how often the inbox is checked for replies
# OUTREACH_MIN_REVIEWS=10          # {Rating} / {Reviews} only with this many reviews ...
# OUTREACH_MIN_RATING=4.0          # ... and this rating
# OUTREACH_AUTOSEND=true           # false: the server never sends on its own

# --- Preview websites (docs/SITES.md) ---
# PREVIEW_SITES=true               # each business a campaign emails gets a website; its first email waits for it
# SITES_URL=https://sites.leadspilot.co

# Google Drive (docs/PLAYBOOK.md step 2) - an OAuth client of type "Desktop app"
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# DRIVE_FOLDER=Leads               # a folder name / path in My Drive, or a folder's URL; empty = My Drive
# DRIVE_AUTO_UPLOAD=true           # upload each search when it finishes, campaign results while they run
