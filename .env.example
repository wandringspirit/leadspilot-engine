# Copy to `.env` and adjust. Every value is optional; defaults live in app/config.py

# Server
HOST=127.0.0.1
PORT=8000
# LOG_BUFFER_SIZE=2000   # log lines kept for the panel's Live logs

# Scraping
HEADLESS=true
# REGION_CODE=us   # bias results to a country (Google 'gl' parameter)
DETAIL_CONCURRENCY=3
MAX_RESULTS=500
# MAX_SCANNED=5000   # distinct listings read per job while looking for matches
# MAX_SECTIONS=200   # map sections searched per job ("whole area" search); each one is a Google search
# PROXY_SERVER=http://user:pass@proxy-host:3128

# Enrichment
ENRICH_MAX_PAGES=6
ENRICH_CONCURRENCY=4
ENRICH_BROWSER_FALLBACK=true
DEFAULT_REGION=US

# Web search for websites a business doesn't list on Google Maps (optional per search)
# WEB_SEARCH_ENGINE=duckduckgo   # or bing; the other one is used when the first refuses
# WEB_SEARCH_DELAY_S=3
